#!/usr/bin/env bash
set -euo pipefail

CDK_MINTD_BIN="${CDK_MINTD_BIN:-cdk-mintd}"
PUBLIC_CONFIG=@@PUBLIC_CONFIG_PATH@@
POSTGRES_SCHEMA_RESET_URL=@@POSTGRES_SCHEMA_RESET_URL@@
RESET_POSTGRES_SCHEMAS="${RESET_POSTGRES_SCHEMAS:-0}"
MEMBERS=(@@MEMBERS@@)
PRIMARY_MEMBER="${PRIMARY_MEMBER:-@@PRIMARY_MEMBER@@}"
UNIT=@@UNIT@@
STATUS_RETRIES="${STATUS_RETRIES:-60}"
STATUS_SLEEP_SECONDS="${STATUS_SLEEP_SECONDS:-1}"
SMOKE_QUOTE_RETRIES="${SMOKE_QUOTE_RETRIES:-300}"
SMOKE_QUOTE_SLEEP_MS="${SMOKE_QUOTE_SLEEP_MS:-100}"
SMOKE_OPERATION_TIMEOUT_SECONDS="${SMOKE_OPERATION_TIMEOUT_SECONDS:-300}"
PIDS=()

member_config() {
  case "$1" in
# @@CONFIG_CASES@@
    *) return 1 ;;
  esac
}

member_work_dir() {
  case "$1" in
# @@WORK_DIR_CASES@@
    *) return 1 ;;
  esac
}

member_private_config() {
  case "$1" in
# @@PRIVATE_CONFIG_CASES@@
    *) return 1 ;;
  esac
}

member_mint_url() {
  case "$1" in
# @@PUBLIC_MINT_URL_CASES@@
    *) return 1 ;;
  esac
}

member_prometheus_url() {
  case "$1" in
# @@PROMETHEUS_URL_CASES@@
    *) return 1 ;;
  esac
}

postgres_member_schema() {
  case "$1" in
# @@POSTGRES_SCHEMA_RESET_CASES@@
    *) return 1 ;;
  esac
}

stop_member() {
  local member="$1"
  local pid="${PIDS[$member]:-}"
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    unset 'PIDS[$member]'
  fi
}

cleanup() {
  local member
  for member in "${MEMBERS[@]}"; do
    stop_member "$member"
  done
}
trap cleanup EXIT

reset_state() {
  local member
  if [[ -n "$POSTGRES_SCHEMA_RESET_URL" ]]; then
    if [[ "$RESET_POSTGRES_SCHEMAS" != "1" ]]; then
      printf 'set RESET_POSTGRES_SCHEMAS=1 to reset generated PostgreSQL test schemas\n' >&2
      return 1
    fi
    command -v psql >/dev/null
    for member in "${MEMBERS[@]}"; do
      local schema
      schema="$(postgres_member_schema "$member")"
      psql "$POSTGRES_SCHEMA_RESET_URL" -v ON_ERROR_STOP=1 -c "DROP SCHEMA IF EXISTS \"$schema\" CASCADE; CREATE SCHEMA \"$schema\";" >/dev/null
    done
  fi
  for member in "${MEMBERS[@]}"; do
    local work_dir
    work_dir="$(member_work_dir "$member")"
    rm -rf "$work_dir"
    mkdir -p "$work_dir"
  done
}

start_members() {
  local member
  for member in "${MEMBERS[@]}"; do
    local work_dir
    work_dir="$(member_work_dir "$member")"
    "$CDK_MINTD_BIN" --work-dir "$work_dir" --config "$(member_config "$member")" >"$work_dir/mintd.log" 2>&1 &
    PIDS[$member]=$!
  done
}

wait_for_member() {
  local member="$1"
  local attempt
  for ((attempt = 1; attempt <= STATUS_RETRIES; attempt++)); do
    if curl --fail --silent --show-error "$(member_mint_url "$member")/v1/info" >/dev/null; then
      return 0
    fi
    sleep "$STATUS_SLEEP_SECONDS"
  done
  printf 'member %s did not become ready\n' "$member" >&2
  return 1
}

reset_state
start_members

for member in "${MEMBERS[@]}"; do
  wait_for_member "$member" &
done
wait

"$CDK_MINTD_BIN" federation smoke-operations \
  --public-config "$PUBLIC_CONFIG" \
  --private-config "$(member_private_config "$PRIMARY_MEMBER")" \
  --unit "$UNIT" \
  --quote-retries "$SMOKE_QUOTE_RETRIES" \
  --quote-sleep-ms "$SMOKE_QUOTE_SLEEP_MS" \
  --operation-timeout-seconds "$SMOKE_OPERATION_TIMEOUT_SECONDS" \
  --scenario standard

printf 'trusted-dealer local federation smoke passed\n'
