# Generated by cdk-mintd federation test-trusted-dealer.
# Contains local test secrets. Do not commit generated copies of this file.
# Start this member with:
# cdk-mintd --work-dir @@WORK_DIR@@ --config @@CONFIG_PATH@@

[info]
url = @@MINT_URL@@
listen_host = @@LISTEN_HOST@@
listen_port = @@LISTEN_PORT@@
mnemonic = @@MNEMONIC@@
enable_info_page = true

[info.http_cache]
backend = "memory"
ttl = 60
tti = 60

[mint_info]
name = @@NAME@@
description = @@DESCRIPTION@@

[prometheus]
enabled = true
address = "127.0.0.1"
port = @@PROMETHEUS_PORT@@

# @@DATABASE_CONFIG@@
[onchain]
onchain_backend = "federated-bdk"
min_mint = 1
max_mint = 500000
min_melt = 1
max_melt = 500000

[federation]
enabled = true
allow_development_payment_observation_policy = true
public_config_path = @@PUBLIC_CONFIG_PATH@@
private_config_path = @@PRIVATE_CONFIG_PATH@@

[federation.onchain_wallet]
enabled = true
network = "regtest"
minimum_confirmations = 1
fee_policy_version = 1
chain_source_type = "bitcoinrpc"
chain_source_scope = "shared"
chain_source_id = "regtest-shared-core"
bitcoind_rpc_host = "127.0.0.1"
bitcoind_rpc_port = 18443
bitcoind_rpc_user = "cdk"
bitcoind_rpc_password = "cdk"
request_timeout_secs = 15
sync_interval_secs = 1
