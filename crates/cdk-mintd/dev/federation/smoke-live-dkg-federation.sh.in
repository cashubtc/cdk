#!/usr/bin/env bash
set -euo pipefail

CDK_MINTD_BIN="${CDK_MINTD_BIN:-cdk-mintd}"
CDK_CLI_BIN="${CDK_CLI_BIN:-cdk-cli}"
BITCOIN_CLI_BIN="${BITCOIN_CLI_BIN:-bitcoin-cli}"
BITCOIN_DOCKER_CONTAINER="${BITCOIN_DOCKER_CONTAINER:-}"
SETUP_PUBLIC_CONFIG=@@SETUP_PUBLIC_CONFIG_PATH@@
FINAL_PUBLIC_CONFIG=@@PRIMARY_FINAL_PUBLIC_CONFIG@@
POSTGRES_SCHEMA_RESET_URL=@@POSTGRES_SCHEMA_RESET_URL@@
RESET_POSTGRES_SCHEMAS="${RESET_POSTGRES_SCHEMAS:-0}"
MEMBERS=(@@MEMBERS@@)
SIGNATURE_THRESHOLD=@@THRESHOLD@@
UNIT=@@UNIT@@
PRIMARY_MEMBER="${PRIMARY_MEMBER:-@@PRIMARY_MEMBER@@}"
INTERRUPTED_MEMBER="${INTERRUPTED_MEMBER:-@@INTERRUPTED_MEMBER@@}"
HELD_MEMBER="${HELD_MEMBER:-@@HELD_MEMBER@@}"
STATUS_RETRIES="${STATUS_RETRIES:-240}"
STATUS_SLEEP_SECONDS="${STATUS_SLEEP_SECONDS:-1}"
INTERRUPT_CHECKPOINT_RETRIES="${INTERRUPT_CHECKPOINT_RETRIES:-2400}"
INTERRUPT_CHECKPOINT_SLEEP_SECONDS=0.05
SMOKE_QUOTE_RETRIES="${SMOKE_QUOTE_RETRIES:-600}"
SMOKE_QUOTE_SLEEP_MS="${SMOKE_QUOTE_SLEEP_MS:-100}"
SMOKE_OPERATION_TIMEOUT_SECONDS="${SMOKE_OPERATION_TIMEOUT_SECONDS:-300}"
DKG_EXPORT_JOBS="${DKG_EXPORT_JOBS:-4}"
DKG_START_JOBS="${DKG_START_JOBS:-2}"
RUNTIME_START_JOBS="${RUNTIME_START_JOBS:-2}"
DKG_CAPTURE_METRICS="${DKG_CAPTURE_METRICS:-0}"
DKG_METRICS_INTERVAL_SECONDS="${DKG_METRICS_INTERVAL_SECONDS:-1}"
DKG_METRICS_DIR="${DKG_METRICS_DIR:-$(dirname "$SETUP_PUBLIC_CONFIG")/dkg-metrics}"
DKG_SETUP_PHASE=1
FROST_BDK_REGTEST="${FROST_BDK_REGTEST:-0}"
FROST_BDK_FAULT_PROFILE="${FROST_BDK_FAULT_PROFILE:-happy}"
FROST_BDK_CLI_WORK_DIR="${FROST_BDK_CLI_WORK_DIR:-$(dirname "$SETUP_PUBLIC_CONFIG")/frost-bdk-cli}"
FROST_BDK_CHECKPOINT_DIR="${FROST_BDK_CHECKPOINT_DIR:-$(dirname "$SETUP_PUBLIC_CONFIG")/frost-bdk-checkpoints}"
FROST_BDK_DEPOSIT_AMOUNTS="${FROST_BDK_DEPOSIT_AMOUNTS:-50000 40000}"
FROST_BDK_MELT_AMOUNTS="${FROST_BDK_MELT_AMOUNTS:-10000 12000}"
FROST_BDK_WAIT_RETRIES="${FROST_BDK_WAIT_RETRIES:-300}"
FROST_BDK_WAIT_SLEEP_SECONDS="${FROST_BDK_WAIT_SLEEP_SECONDS:-1}"
FROST_BDK_MEMBER_REQUEST_TIMEOUT_SECONDS="${FROST_BDK_MEMBER_REQUEST_TIMEOUT_SECONDS:-60}"
FROST_BDK_MEMBER_REQUEST_MAX_RETRIES="${FROST_BDK_MEMBER_REQUEST_MAX_RETRIES:-200}"
PIDS=()
METRICS_PID=""
DKG_SETUP_STARTED_SECONDS=0
DKG_METRICS_REPORTED=0

member_config() {
  if [[ "$DKG_SETUP_PHASE" == "0" && "$FROST_BDK_REGTEST" == "1" ]]; then
    member_frost_bdk_config "$1"
    return
  fi
  case "$1" in
# @@CONFIG_CASES@@
    *) return 1 ;;
  esac
}

member_frost_bdk_config() {
  case "$1" in
# @@FROST_BDK_CONFIG_CASES@@
    *) return 1 ;;
  esac
}

member_work_dir() {
  case "$1" in
# @@WORK_DIR_CASES@@
    *) return 1 ;;
  esac
}

member_setup_private_config() {
  case "$1" in
# @@SETUP_PRIVATE_CONFIG_CASES@@
    *) return 1 ;;
  esac
}

member_final_config_dir() {
  case "$1" in
# @@FINAL_CONFIG_DIR_CASES@@
    *) return 1 ;;
  esac
}

member_final_private_config() {
  printf '%s/federation-private.json\n' "$(member_final_config_dir "$1")"
}

member_mint_url() {
  case "$1" in
# @@PUBLIC_MINT_URL_CASES@@
    *) return 1 ;;
  esac
}

bitcoin_cli() {
  if [[ -n "$BITCOIN_DOCKER_CONTAINER" ]]; then
    docker exec "$BITCOIN_DOCKER_CONTAINER" bitcoin-cli -regtest -rpcuser=cdk -rpcpassword=cdk "$@"
  else
    "$BITCOIN_CLI_BIN" -regtest -rpcuser=cdk -rpcpassword=cdk "$@"
  fi
}

bitcoin_wallet_cli() {
  bitcoin_cli -rpcwallet=cdk-frost-regtest "$@"
}

wait_for_bitcoin() {
  for _ in $(seq 1 "$FROST_BDK_WAIT_RETRIES"); do
    if bitcoin_cli getblockchaininfo >/dev/null 2>&1; then
      bitcoin_cli -named createwallet wallet_name=cdk-frost-regtest descriptors=true load_on_startup=true >/dev/null 2>&1 || true
      if bitcoin_wallet_cli getwalletinfo >/dev/null 2>&1; then
        return 0
      fi
    fi
    sleep "$FROST_BDK_WAIT_SLEEP_SECONDS"
  done
  printf 'Bitcoin Core regtest RPC did not become ready\n' >&2
  return 1
}

mine_blocks() {
  local blocks="$1"
  local mining_address
  mining_address="$(bitcoin_wallet_cli getnewaddress cdk-frost-harness bech32)"
  bitcoin_wallet_cli generatetoaddress "$blocks" "$mining_address" >/dev/null
}

sats_to_btc() {
  awk -v sats="$1" 'BEGIN { printf "%.8f", sats / 100000000 }'
}

wait_for_log_line() {
  local file="$1"
  local pattern="$2"
  for _ in $(seq 1 "$FROST_BDK_WAIT_RETRIES"); do
    if [[ -f "$file" ]] && grep -q "$pattern" "$file"; then
      return 0
    fi
    sleep "$FROST_BDK_WAIT_SLEEP_SECONDS"
  done
  printf 'timed out waiting for %s in %s\n' "$pattern" "$file" >&2
  [[ -f "$file" ]] && tail -n 120 "$file" >&2
  return 1
}

capture_federation_checkpoint_output() {
  local output="$1"
  shift
  if ! "$@" > "$output" 2>&1; then
    if [[ "$FROST_BDK_FAULT_PROFILE" == "offline-one" \
      && -z "${PIDS[$HELD_MEMBER]:-}" ]]; then
      printf 'expected temporary diagnostic unavailability while member %s is offline\n' \
        "$HELD_MEMBER" >> "$output"
    else
      cat "$output" >&2
      return 1
    fi
  fi
}

capture_frost_bdk_checkpoint() {
  local label="$1"
  local checkpoint="$FROST_BDK_CHECKPOINT_DIR/$label"
  mkdir -p "$checkpoint"
  if [[ "${#PIDS[@]}" == "${#MEMBERS[@]}" ]]; then
    wait_for_converged
  fi
  capture_federation_checkpoint_output "$checkpoint/federation-status.txt" \
    "$CDK_MINTD_BIN" federation status \
    --public-config "$FINAL_PUBLIC_CONFIG" \
    --private-config "$(member_final_private_config "$PRIMARY_MEMBER")"
  capture_federation_checkpoint_output "$checkpoint/wallet-status.txt" \
    "$CDK_MINTD_BIN" federation wallet-status \
    --public-config "$FINAL_PUBLIC_CONFIG" \
    --private-config "$(member_final_private_config "$PRIMARY_MEMBER")"
  capture_federation_checkpoint_output "$checkpoint/digests.txt" compare_digests
  bitcoin_cli getblockchaininfo > "$checkpoint/bitcoin-chain.json"
  bitcoin_cli getrawmempool true > "$checkpoint/bitcoin-mempool.json"
  bitcoin_cli gettxoutsetinfo > "$checkpoint/bitcoin-utxos.json"
  "$CDK_CLI_BIN" --work-dir "$FROST_BDK_CLI_WORK_DIR" --non-interactive --unit "$UNIT" balance \
    > "$checkpoint/cashu-balance.txt"
}

postgres_member_schema() {
  case "$1" in
# @@POSTGRES_SCHEMA_RESET_CASES@@
    *) return 1 ;;
  esac
}

record_metrics_member_pid() {
  local member="$1"
  local pid="$2"
  if [[ "$DKG_CAPTURE_METRICS" != "1" ]]; then
    return 0
  fi
  mkdir -p "$DKG_METRICS_DIR"
  printf '%s\n' "$pid" > "$DKG_METRICS_DIR/member-$member.pid"
}

clear_metrics_member_pid() {
  local member="$1"
  if [[ "$DKG_CAPTURE_METRICS" == "1" ]]; then
    rm -f "$DKG_METRICS_DIR/member-$member.pid"
  fi
}

start_member() {
  local member="$1"
  local config
  local work_dir
  local mintd_env=(CDK_MINTD_PROMETHEUS_ENABLED=false)
  config="$(member_config "$member")"
  work_dir="$(member_work_dir "$member")"
  mkdir -p "$work_dir"
  if [[ "$DKG_SETUP_PHASE" == "1" ]]; then
    mintd_env+=(CDK_FEDERATION_DISABLE_PEER_SYNC=1)
    if [[ "$DKG_CAPTURE_METRICS" == "1" ]]; then
      mintd_env+=(CDK_MINTD_FEDERATION_DKG_TRACE_TICKS=1)
      mintd_env+=(RUST_LOG=warn,cdk_axum::federation::dkg_driver=info)
    fi
  else
    mintd_env+=(CDK_MINTD_FEDERATION_OPERATION_SUBMISSION_TIMEOUT_SECS="$SMOKE_OPERATION_TIMEOUT_SECONDS")
  fi
  env "${mintd_env[@]}" "$CDK_MINTD_BIN" --work-dir "$work_dir" --config "$config" >> "$work_dir/mintd.log" 2>&1 &
  PIDS[$member]=$!
  record_metrics_member_pid "$member" "${PIDS[$member]}"
  printf 'started live DKG member %s with pid %s\n' "$member" "${PIDS[$member]}"
}

wait_for_dkg_listener() {
  local member="$1"
  local pid="${PIDS[$member]:-}"
  local mint_url
  mint_url="$(member_mint_url "$member")"
  for _ in $(seq 1 "$STATUS_RETRIES"); do
    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
      printf 'member %s exited during bounded DKG startup\n' "$member" >&2
      tail -n 120 "$(member_work_dir "$member")/mintd.log" >&2 || true
      return 1
    fi
    if curl --max-time "$STATUS_SLEEP_SECONDS" -fsS "$mint_url/v1/info" >/dev/null 2>&1; then
      return 0
    fi
    sleep "$STATUS_SLEEP_SECONDS"
  done
  printf 'member %s did not expose its DKG listener after bounded startup\n' "$member" >&2
  tail -n 120 "$(member_work_dir "$member")/mintd.log" >&2 || true
  return 1
}

start_dkg_members_bounded() {
  local member
  local batch=()
  for member in "${MEMBERS[@]}"; do
    if [[ "$member" == "$HELD_MEMBER" ]]; then
      continue
    fi
    start_member "$member"
    batch+=("$member")
    if (( ${#batch[@]} >= DKG_START_JOBS )); then
      for member in "${batch[@]}"; do
        wait_for_dkg_listener "$member"
      done
      batch=()
    fi
  done
  if (( ${#batch[@]} > 0 )); then
    for member in "${batch[@]}"; do
      wait_for_dkg_listener "$member"
    done
  fi
  start_member "$HELD_MEMBER"
  wait_for_dkg_listener "$HELD_MEMBER"
}

stop_member() {
  local member="$1"
  local pid="${PIDS[$member]:-}"
  if [[ -z "$pid" ]]; then
    return 0
  fi
  if [[ "$DKG_CAPTURE_METRICS" == "1" && -f "$DKG_METRICS_DIR/process.csv" ]]; then
    sample_member_metrics "$member" "$(date +%s)" || true
  fi
  clear_metrics_member_pid "$member"
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  unset 'PIDS[$member]'
  printf 'stopped live DKG member %s\n' "$member"
}

cleanup() {
  local report_failed_setup=0
  if [[ "$DKG_CAPTURE_METRICS" == "1" && "$DKG_METRICS_REPORTED" == "0" && -f "$DKG_METRICS_DIR/process.csv" ]]; then
    sample_dkg_metrics || true
    report_failed_setup=1
  fi
  stop_metrics_monitor
  local member
  for member in "${MEMBERS[@]}"; do
    stop_member "$member"
  done
  if [[ "$report_failed_setup" == "1" ]]; then
    report_dkg_metrics setup_failure || true
  fi
}

sample_member_metrics() {
  local member="$1"
  local sampled_at="$2"
  local pid_file="$DKG_METRICS_DIR/member-$member.pid"
  local pid
  if [[ ! -f "$pid_file" ]] || ! read -r pid < "$pid_file"; then
    return 0
  fi
  local sample
  if ! sample="$(ps -p "$pid" -o %cpu= -o rss= -o utime= -o stime= 2>/dev/null | awk 'NF { print $1 "," $2 "," $3 "," $4; exit }')"; then
    return 0
  fi
  if [[ -n "$sample" ]]; then
    printf '%s,%s,%s,%s\n' "$sampled_at" "$member" "$pid" "$sample" >> "$DKG_METRICS_DIR/process.csv"
  fi
}

sample_dkg_metrics() {
  if [[ "$DKG_CAPTURE_METRICS" != "1" ]]; then
    return 0
  fi
  local sampled_at
  sampled_at="$(date +%s)"
  local member
  for member in "${MEMBERS[@]}"; do
    sample_member_metrics "$member" "$sampled_at"
  done

  local info_sample
  info_sample="$(curl -sS -o /dev/null -w '%{http_code},%{time_total}' "$(member_mint_url "$PRIMARY_MEMBER")/v1/info" 2>/dev/null || true)"
  if [[ -n "$info_sample" ]]; then
    printf '%s,%s\n' "$sampled_at" "$info_sample" >> "$DKG_METRICS_DIR/rest.csv"
  fi
}

run_metrics_monitor() {
  while true; do
    sample_dkg_metrics
    sleep "$DKG_METRICS_INTERVAL_SECONDS"
  done
}

start_metrics_monitor() {
  if [[ "$DKG_CAPTURE_METRICS" != "1" ]]; then
    return 0
  fi
  mkdir -p "$DKG_METRICS_DIR"
  rm -f "$DKG_METRICS_DIR"/member-*.pid
  printf 'sampled_at,member,pid,cpu_percent,rss_kb,user_time,system_time\n' > "$DKG_METRICS_DIR/process.csv"
  printf 'sampled_at,http_status,time_total_seconds\n' > "$DKG_METRICS_DIR/rest.csv"
  run_metrics_monitor &
  METRICS_PID=$!
}

stop_metrics_monitor() {
  if [[ -z "$METRICS_PID" ]]; then
    return 0
  fi
  kill "$METRICS_PID" 2>/dev/null || true
  wait "$METRICS_PID" 2>/dev/null || true
  METRICS_PID=""
}

report_dkg_metrics() {
  if [[ "$DKG_CAPTURE_METRICS" != "1" ]]; then
    return 0
  fi
  if [[ "$DKG_METRICS_REPORTED" == "1" ]]; then
    return 0
  fi
  DKG_METRICS_REPORTED=1
  local result="${1:-setup_success}"
  printf 'dkg_metrics_result=%s\n' "$result"
  printf 'dkg_setup_wall_seconds=%s\n' "$((SECONDS - DKG_SETUP_STARTED_SECONDS))"
  awk -F, '
    function cpu_seconds(raw, parts, count) {
      count = split(raw, parts, ":");
      if (count == 2) return (parts[1] * 60) + parts[2];
      if (count == 3) return (parts[1] * 3600) + (parts[2] * 60) + parts[3];
      return raw + 0;
    }
    NR > 1 {
      samples[$2] += 1; cpu[$2] += $4;
      if ($4 > peak_cpu[$2]) peak_cpu[$2] = $4;
      if ($5 > peak_rss[$2]) peak_rss[$2] = $5;
      process = $2 SUBSEP $3;
      user_seconds = cpu_seconds($6);
      system_seconds = cpu_seconds($7);
      if (!(process in process_user) || user_seconds > process_user[process]) process_user[process] = user_seconds;
      if (!(process in process_system) || system_seconds > process_system[process]) process_system[process] = system_seconds;
    }
    END {
      for (process in process_user) {
        split(process, identity, SUBSEP);
        total_user[identity[1]] += process_user[process];
      }
      for (process in process_system) {
        split(process, identity, SUBSEP);
        total_system[identity[1]] += process_system[process];
      }
      for (member in samples) printf "dkg_process member=%s samples=%d average_cpu_percent=%.2f peak_cpu_percent=%.2f peak_rss_kb=%d total_user_seconds=%.2f total_system_seconds=%.2f\n", member, samples[member], cpu[member] / samples[member], peak_cpu[member], peak_rss[member], total_user[member], total_system[member];
    }
  ' "$DKG_METRICS_DIR/process.csv" | sort
  awk -F, '
    NR > 1 {
      samples += 1; latency += $3;
      if ($3 > peak_latency) peak_latency = $3;
      if ($2 >= 200 && $2 < 300) {
        successes += 1; seen_success = 1;
      } else if (seen_success) {
        runtime_failures += 1;
      } else {
        startup_failures += 1;
      }
    }
    END {
      if (samples > 0) printf "dkg_rest samples=%d successes=%d startup_failures=%d runtime_failures=%d average_seconds=%.6f peak_seconds=%.6f\n", samples, successes, startup_failures, runtime_failures, latency / samples, peak_latency;
    }
  ' "$DKG_METRICS_DIR/rest.csv"
  local member
  for member in "${MEMBERS[@]}"; do
    awk -v member="$member" '
      /Federation DKG driver tick metrics/ {
        for (field = 1; field <= NF; field += 1) {
          split($field, value, "=");
          if (value[1] == "attempted_deliveries") attempted += value[2];
          if (value[1] == "successful_deliveries") successful += value[2];
          if (value[1] == "failed_deliveries") failed += value[2];
        }
      }
      /Federation DKG delivery failed/ && /failure_kind="timeout"/ { timeouts += 1 }
      END {
        unique = @@MEMBER_COUNT@@ * 5;
        duplicates = successful > unique ? successful - unique : 0;
        printf "dkg_delivery member=%s attempted=%d successful=%d failed=%d timeouts=%d duplicate_successes=%d\n", member, attempted, successful, failed, timeouts, duplicates;
      }
    ' "$(member_work_dir "$member")/mintd.log"
  done
  printf 'dkg_metrics_dir=%s\n' "$DKG_METRICS_DIR"
}

reset_postgres_schemas() {
  if [[ -z "$POSTGRES_SCHEMA_RESET_URL" ]]; then
    return 0
  fi
  if [[ "$RESET_POSTGRES_SCHEMAS" != "1" ]]; then
    printf 'set RESET_POSTGRES_SCHEMAS=1 before a generated PostgreSQL live DKG smoke\n' >&2
    return 1
  fi
  if ! command -v psql >/dev/null 2>&1; then
    printf 'psql is required for the PostgreSQL live DKG smoke\n' >&2
    return 1
  fi
  local member
  for member in "${MEMBERS[@]}"; do
    local schema
    schema="$(postgres_member_schema "$member")"
    psql "$POSTGRES_SCHEMA_RESET_URL" -v ON_ERROR_STOP=1 -c "DROP SCHEMA IF EXISTS \"$schema\" CASCADE; CREATE SCHEMA \"$schema\";" >/dev/null
  done
}

reset_live_dkg_state() {
  reset_postgres_schemas
  local member
  for member in "${MEMBERS[@]}"; do
    rm -rf "$(member_work_dir "$member")" "$(member_final_config_dir "$member")"
    mkdir -p "$(member_work_dir "$member")"
  done
}

status_field() {
  local line="$1"
  local key="$2"
  local field
  for field in $line; do
    case "$field" in
      "$key"=*) printf '%s\n' "${field#*=}"; return 0 ;;
    esac
  done
  return 1
}

member_dkg_setup_line() {
  local member="$1"
  "$CDK_MINTD_BIN" \
    --work-dir "$(member_work_dir "$member")" \
    --config "$(member_config "$member")" \
    federation dkg-status \
    --public-config "$SETUP_PUBLIC_CONFIG" \
    --private-config "$(member_setup_private_config "$member")" \
    --from-database --progress-only | awk '/^setup_records / { print; exit }'
}

member_dkg_records_complete() {
  local member="$1"
  local line
  line="$(member_dkg_setup_line "$member" 2>/dev/null)" || return 1
  [[ "$(status_field "$line" keyset_shares || true)" == "1" && "$(status_field "$line" transcript_signatures || true)" == "${#MEMBERS[@]}" && "$(status_field "$line" activations || true)" == "${#MEMBERS[@]}" && "$(status_field "$line" frost_root_public_configs || true)" == "1" ]]
}

wait_for_dkg_participant() {
  local member="$1"
  local work_dir
  work_dir="$(member_work_dir "$member")"
  for _ in $(seq 1 "$STATUS_RETRIES"); do
    local line
    if line="$(member_dkg_setup_line "$member" 2>/dev/null)"; then
      if [[ "$(status_field "$line" participant_states || true)" == "1" && "$(status_field "$line" participant_state_members || true)" == "$member" ]]; then
        printf '%s\n' "$line"
        return 0
      fi
    fi
    sleep "$STATUS_SLEEP_SECONDS"
  done
  printf 'member %s did not persist its live DKG participant state\n' "$member" >&2
  member_dkg_setup_line "$member" >&2 || true
  tail -n 100 "$work_dir/mintd.log" >&2 || true
  return 1
}

wait_for_interrupt_checkpoint() {
  local member="$1"
  local work_dir
  work_dir="$(member_work_dir "$member")"
  for _ in $(seq 1 "$INTERRUPT_CHECKPOINT_RETRIES"); do
    local line
    if line="$(member_dkg_setup_line "$member" 2>/dev/null)"; then
      local tick_metric_ready=1
      if [[ "$DKG_CAPTURE_METRICS" == "1" ]] && ! grep -q 'Federation DKG driver tick metrics' "$work_dir/mintd.log"; then
        tick_metric_ready=0
      fi
      if [[ "$tick_metric_ready" == "1" && "$(status_field "$line" participant_states || true)" == "1" && "$(status_field "$line" commitments || true)" == "${#MEMBERS[@]}" && "$(status_field "$line" keyset_shares || true)" == "0" ]]; then
        printf '%s\n' "$line"
        return 0
      fi
      if [[ "$(status_field "$line" keyset_shares || true)" == "1" ]]; then
        printf 'member %s passed the intended pre-keyset interruption checkpoint\n' "$member" >&2
        printf '%s\n' "$line" >&2
        return 1
      fi
    fi
    sleep "$INTERRUPT_CHECKPOINT_SLEEP_SECONDS"
  done
  printf 'member %s did not reach the durable pre-keyset interruption checkpoint\n' "$member" >&2
  member_dkg_setup_line "$member" >&2 || true
  tail -n 100 "$work_dir/mintd.log" >&2 || true
  return 1
}

wait_for_dkg_driver_metric_completion() {
  local member="$1"
  if [[ "$DKG_CAPTURE_METRICS" != "1" ]]; then
    return 0
  fi
  local work_dir
  work_dir="$(member_work_dir "$member")"
  for _ in $(seq 1 200); do
    if grep -q 'Federation DKG ceremony completed' "$work_dir/mintd.log"; then
      return 0
    fi
    sleep "$INTERRUPT_CHECKPOINT_SLEEP_SECONDS"
  done
  printf 'member %s did not flush its completed DKG driver metrics\n' "$member" >&2
  tail -n 100 "$work_dir/mintd.log" >&2 || true
  return 1
}

wait_for_dkg_ready() {
  local member="$1"
  local work_dir
  work_dir="$(member_work_dir "$member")"
  for _ in $(seq 1 "$STATUS_RETRIES"); do
    local pid="${PIDS[$member]:-}"
    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
      printf 'member %s exited before persisting a complete live DKG record set\n' "$member" >&2
      tail -n 120 "$work_dir/mintd.log" >&2 || true
      return 1
    fi
    if member_dkg_records_complete "$member"; then
      return 0
    fi
    sleep "$STATUS_SLEEP_SECONDS"
  done
  printf 'member %s did not persist a complete live DKG record set\n' "$member" >&2
  member_dkg_setup_line "$member" >&2 || true
  tail -n 120 "$work_dir/mintd.log" >&2 || true
  return 1
}

export_final_config() {
  local member="$1"
  local bootstrap_args=()
  if [[ "$FROST_BDK_REGTEST" == "1" ]]; then
    bootstrap_args+=(
      --frost-cdk-network regtest
      --frost-cdk-minimum-confirmations 1
      --frost-cdk-fee-policy-version 1
      --frost-cdk-application-key-epoch 1
    )
  fi
  "$CDK_MINTD_BIN" \
    --work-dir "$(member_work_dir "$member")" \
    --config "$(member_config "$member")" \
    federation dkg-status \
    --public-config "$SETUP_PUBLIC_CONFIG" \
    --private-config "$(member_setup_private_config "$member")" \
    --from-database --require-ready \
    "${bootstrap_args[@]}" \
    --final-config-dir "$(member_final_config_dir "$member")"
}

export_final_configs() {
  local member index
  local -a export_members=()
  local -a export_pids=()
  for member in "${MEMBERS[@]}"; do
    mkdir -p "$(member_final_config_dir "$member")"
    export_final_config "$member" >"$(member_final_config_dir "$member")/export.log" 2>&1 &
    export_members+=("$member")
    export_pids+=("$!")
    if (( ${#export_pids[@]} >= DKG_EXPORT_JOBS )); then
      for index in "${!export_pids[@]}"; do
        if ! wait "${export_pids[$index]}"; then
          printf 'member %s failed to export its final DKG config\n' "${export_members[$index]}" >&2
          cat "$(member_final_config_dir "${export_members[$index]}")/export.log" >&2
          return 1
        fi
      done
      export_members=()
      export_pids=()
    fi
  done
  for index in "${!export_pids[@]}"; do
    if ! wait "${export_pids[$index]}"; then
      printf 'member %s failed to export its final DKG config\n' "${export_members[$index]}" >&2
      cat "$(member_final_config_dir "${export_members[$index]}")/export.log" >&2
      return 1
    fi
  done
}

compare_final_public_configs() {
  local member
  for member in "${MEMBERS[@]}"; do
    cmp -s "$FINAL_PUBLIC_CONFIG" "$(member_final_config_dir "$member")/federation-public.json" || {
      printf 'member %s assembled a different final DKG public config\n' "$member" >&2
      return 1
    }
  done
}

wait_for_runtime_keysets() {
  local member="$1"
  local mint_url
  mint_url="$(member_mint_url "$member")"
  for _ in $(seq 1 "$STATUS_RETRIES"); do
    if curl -fsS "$mint_url/v1/keysets" 2>/dev/null | grep -q '"id"'; then
      return 0
    fi
    sleep "$STATUS_SLEEP_SECONDS"
  done
  printf 'member %s did not activate the finalized DKG keyset after restart\n' "$member" >&2
  tail -n 120 "$(member_work_dir "$member")/mintd.log" >&2 || true
  return 1
}

start_runtime_members_bounded() {
  local member
  local batch=()
  for member in "${MEMBERS[@]}"; do
    start_member "$member"
    batch+=("$member")
    if (( ${#batch[@]} >= RUNTIME_START_JOBS )); then
      for member in "${batch[@]}"; do
        wait_for_runtime_keysets "$member"
      done
      batch=()
    fi
  done
  for member in "${batch[@]}"; do
    wait_for_runtime_keysets "$member"
  done
}

member_status_line() {
  local member="$1"
  "$CDK_MINTD_BIN" federation status \
    --public-config "$FINAL_PUBLIC_CONFIG" \
    --private-config "$(member_final_private_config "$member")" \
    --member "$member" --require-ready | awk '/^member / { print; exit }'
}

wait_for_member_status() {
  local member="$1"
  for _ in $(seq 1 "$STATUS_RETRIES"); do
    if member_status_line "$member" >/dev/null 2>&1; then
      return 0
    fi
    sleep "$STATUS_SLEEP_SECONDS"
  done
  printf 'member %s did not become ready after DKG activation restart\n' "$member" >&2
  member_status_line "$member" >&2 || true
  tail -n 120 "$(member_work_dir "$member")/mintd.log" >&2 || true
  return 1
}

compare_digests() {
  "$CDK_MINTD_BIN" federation compare-digests \
    --public-config "$FINAL_PUBLIC_CONFIG" \
    --private-config "$(member_final_private_config "$PRIMARY_MEMBER")"
}

has_certified_convergence() {
  local output="$1"
  shift
  local recovered_members=" $* "
  if ! "$CDK_MINTD_BIN" federation status \
    --public-config "$FINAL_PUBLIC_CONFIG" \
    --private-config "$(member_final_private_config "$PRIMARY_MEMBER")" \
    > "$output" 2>&1; then
    return 1
  fi
  awk -v expected="${#MEMBERS[@]}" -v recovered_members="$recovered_members" '
    $1 == "member" {
      members += 1
      healthy += ($0 ~ /sync=healthy ready=true/)
      member_id = $2
      sub(/:$/, "", member_id)
      latest = ""
      certified = ""
      for (field = 1; field <= NF; field += 1) {
        split($field, value, "=")
        if (value[1] == "latest_index") latest = value[2]
        if (value[1] == "catch_up_certificate_quorum_latest") certified = value[2]
      }
      requires_certificate = index(recovered_members, " " member_id " ") > 0
      covered += (!requires_certificate || (latest != "" && latest == certified))
    }
    END {
      exit !(members == expected && healthy == expected && covered == expected)
    }
  ' "$output"
}

wait_for_converged() {
  mkdir -p "$FROST_BDK_CHECKPOINT_DIR"
  local convergence_status="$FROST_BDK_CHECKPOINT_DIR/.convergence-status.txt"
  for _ in $(seq 1 "$STATUS_RETRIES"); do
    if compare_digests >/dev/null 2>&1 \
      && has_certified_convergence "$convergence_status" "$@"; then
      return 0
    fi
    sleep "$STATUS_SLEEP_SECONDS"
  done
  printf 'live DKG federation did not reach certified convergence\n' >&2
  [[ -f "$convergence_status" ]] && cat "$convergence_status" >&2
  compare_digests >&2 || true
  return 1
}

cashu_balance() {
  "$CDK_CLI_BIN" --work-dir "$FROST_BDK_CLI_WORK_DIR" --non-interactive --unit "$UNIT" balance \
    | awk '/Total balance across all wallets:/ { print $(NF - 1); exit }'
}

run_onchain_mint() {
  local sequence="$1"
  local amount="$2"
  local log="$FROST_BDK_CHECKPOINT_DIR/onchain-mint-$sequence.log"
  local mint_pid
  "$CDK_CLI_BIN" --work-dir "$FROST_BDK_CLI_WORK_DIR" --non-interactive --unit "$UNIT" \
    mint "$(member_mint_url "$PRIMARY_MEMBER")" "$amount" --method onchain --wait-duration 0 \
    > "$log" 2>&1 &
  mint_pid=$!
  wait_for_log_line "$log" '^Send sats to: '
  local address
  address="$(awk '/^Send sats to: / { print $4; exit }' "$log")"
  if [[ -z "$address" ]]; then
    printf 'on-chain mint %s produced no deposit address\n' "$sequence" >&2
    return 1
  fi
  local txid
  txid="$(bitcoin_wallet_cli sendtoaddress "$address" "$(sats_to_btc "$amount")")"
  mine_blocks 1
  if ! wait "$mint_pid"; then
    cat "$log" >&2
    return 1
  fi
  grep -q "Received $amount from mint" "$log"
  bitcoin_wallet_cli gettransaction "$txid" > "$FROST_BDK_CHECKPOINT_DIR/deposit-$sequence-bitcoin.json"
  printf '%s\n' "$txid" >> "$FROST_BDK_CHECKPOINT_DIR/deposit-txids.txt"
}

new_mempool_txid() {
  local before="$1"
  bitcoin_cli getrawmempool \
    | jq -r --argjson before "$before" '.[] | select(. as $txid | ($before | index($txid) | not))' \
    | head -n 1
}

run_onchain_melt() {
  local sequence="$1"
  local amount="$2"
  local destination
  destination="$(bitcoin_wallet_cli getnewaddress "cdk-frost-melt-$sequence" bech32m)"
  local before
  before="$(bitcoin_cli getrawmempool)"
  local log="$FROST_BDK_CHECKPOINT_DIR/onchain-melt-$sequence.log"
  local melt_pid
  "$CDK_CLI_BIN" --work-dir "$FROST_BDK_CLI_WORK_DIR" --non-interactive --unit "$UNIT" \
    melt --method onchain --mint-url "$(member_mint_url "$PRIMARY_MEMBER")" \
    --address "$destination" --amount "$amount" --network regtest --onchain-quote-index 0 \
    > "$log" 2>&1 &
  melt_pid=$!
  local txid=""
  for _ in $(seq 1 "$FROST_BDK_WAIT_RETRIES"); do
    txid="$(new_mempool_txid "$before")"
    if [[ -n "$txid" ]]; then
      break
    fi
    if ! kill -0 "$melt_pid" 2>/dev/null; then
      wait "$melt_pid" || true
      cat "$log" >&2
      return 1
    fi
    sleep "$FROST_BDK_WAIT_SLEEP_SECONDS"
  done
  if [[ -z "$txid" ]]; then
    printf 'on-chain melt %s did not broadcast a transaction\n' "$sequence" >&2
    cat "$log" >&2
    return 1
  fi
  bitcoin_cli getrawtransaction "$txid" true > "$FROST_BDK_CHECKPOINT_DIR/melt-$sequence-transaction.json"
  local matching_outputs
  matching_outputs="$(jq --arg destination "$destination" --argjson amount "$amount" \
    '[.vout[] | select(.scriptPubKey.address == $destination and ((.value * 100000000 | round) == $amount))] | length' \
    "$FROST_BDK_CHECKPOINT_DIR/melt-$sequence-transaction.json")"
  if [[ "$matching_outputs" != "1" ]]; then
    printf 'on-chain melt %s did not contain exactly one authorized recipient output\n' "$sequence" >&2
    return 1
  fi
  mine_blocks 1
  if ! wait "$melt_pid"; then
    cat "$log" >&2
    return 1
  fi
  grep -q 'Payment successful:' "$log"
  printf '%s\n' "$txid" >> "$FROST_BDK_CHECKPOINT_DIR/melt-txids.txt"
}

exercise_frost_bdk_fault_profile() {
  case "$FROST_BDK_FAULT_PROFILE" in
    happy) ;;
    offline-one)
      stop_member "$HELD_MEMBER"
      ;;
    process-kill)
      local pid="${PIDS[$INTERRUPTED_MEMBER]:-}"
      [[ -n "$pid" ]] || return 1
      kill -9 "$pid"
      wait "$pid" 2>/dev/null || true
      unset 'PIDS[$INTERRUPTED_MEMBER]'
      start_member "$INTERRUPTED_MEMBER"
      wait_for_member_status "$INTERRUPTED_MEMBER"
      wait_for_converged "$INTERRUPTED_MEMBER"
      ;;
    below-threshold-heal)
      local stopped=0
      local member
      local recovered_members=()
      for member in "${MEMBERS[@]}"; do
        if [[ "$member" != "$PRIMARY_MEMBER" && "$stopped" -lt "$SIGNATURE_THRESHOLD" ]]; then
          stop_member "$member"
          recovered_members+=("$member")
          stopped=$((stopped + 1))
        fi
      done
      if "$CDK_CLI_BIN" --work-dir "$FROST_BDK_CLI_WORK_DIR" --non-interactive \
        mint-info "$(member_mint_url "$PRIMARY_MEMBER")" >/dev/null 2>&1; then
        printf 'below-threshold wallet read unexpectedly succeeded\n' >&2
        return 1
      fi
      for member in "${MEMBERS[@]}"; do
        if [[ -z "${PIDS[$member]:-}" ]]; then
          start_member "$member"
          wait_for_member_status "$member"
        fi
      done
      wait_for_converged "${recovered_members[@]}"
      ;;
    *)
      printf 'unknown FROST_BDK_FAULT_PROFILE %s\n' "$FROST_BDK_FAULT_PROFILE" >&2
      return 1
      ;;
  esac
}

run_frost_bdk_regtest() {
  wait_for_bitcoin
  rm -rf "$FROST_BDK_CLI_WORK_DIR" "$FROST_BDK_CHECKPOINT_DIR"
  mkdir -p "$FROST_BDK_CLI_WORK_DIR" "$FROST_BDK_CHECKPOINT_DIR"
  mine_blocks 101
  "$CDK_CLI_BIN" --work-dir "$FROST_BDK_CLI_WORK_DIR" --non-interactive \
    federation add --public-config "$FINAL_PUBLIC_CONFIG" \
    --member-request-timeout-secs "$FROST_BDK_MEMBER_REQUEST_TIMEOUT_SECONDS" \
    --member-request-max-retries "$FROST_BDK_MEMBER_REQUEST_MAX_RETRIES"
  capture_frost_bdk_checkpoint 00-activated
  exercise_frost_bdk_fault_profile

  local sequence=0
  local amount
  for amount in $FROST_BDK_DEPOSIT_AMOUNTS; do
    sequence=$((sequence + 1))
    run_onchain_mint "$sequence" "$amount"
    capture_frost_bdk_checkpoint "1$sequence-deposit-confirmed"
  done
  local funded_balance
  funded_balance="$(cashu_balance)"
  local expected_funded=0
  for amount in $FROST_BDK_DEPOSIT_AMOUNTS; do
    expected_funded=$((expected_funded + amount))
  done
  if [[ "$funded_balance" != "$expected_funded" ]]; then
    printf 'Cashu balance after deposits was %s, expected %s\n' "$funded_balance" "$expected_funded" >&2
    return 1
  fi

  sequence=0
  for amount in $FROST_BDK_MELT_AMOUNTS; do
    sequence=$((sequence + 1))
    run_onchain_melt "$sequence" "$amount"
    capture_frost_bdk_checkpoint "2$sequence-melt-confirmed"
  done
  local final_balance
  final_balance="$(cashu_balance)"
  if [[ -z "$final_balance" || "$final_balance" -ge "$funded_balance" || "$final_balance" -le 0 ]]; then
    printf 'Cashu balance did not decrease safely after melts: funded=%s final=%s\n' "$funded_balance" "$final_balance" >&2
    return 1
  fi
  if [[ "$(sort -u "$FROST_BDK_CHECKPOINT_DIR/deposit-txids.txt" | wc -l | tr -d ' ')" != "2" \
    || "$(sort -u "$FROST_BDK_CHECKPOINT_DIR/melt-txids.txt" | wc -l | tr -d ' ')" != "2" ]]; then
    printf 'expected exactly two unique deposit and two unique melt transactions\n' >&2
    return 1
  fi

  if [[ "$FROST_BDK_FAULT_PROFILE" == "offline-one" ]]; then
    start_member "$HELD_MEMBER"
    wait_for_member_status "$HELD_MEMBER"
    wait_for_converged "$HELD_MEMBER"
  fi
  capture_frost_bdk_checkpoint 30-recovered
  printf 'live dealer-free dual DKG and federated BDK on-chain mint/melt smoke passed\n'
}

validate_live_dkg_smoke() {
  if (( ${#MEMBERS[@]} < 3 )); then
    printf 'live DKG interruption smoke requires at least three members\n' >&2
    return 1
  fi
  member_config "$PRIMARY_MEMBER" >/dev/null || { printf 'unknown PRIMARY_MEMBER %s\n' "$PRIMARY_MEMBER" >&2; return 1; }
  member_config "$INTERRUPTED_MEMBER" >/dev/null || { printf 'unknown INTERRUPTED_MEMBER %s\n' "$INTERRUPTED_MEMBER" >&2; return 1; }
  member_config "$HELD_MEMBER" >/dev/null || { printf 'unknown HELD_MEMBER %s\n' "$HELD_MEMBER" >&2; return 1; }
  if [[ "$INTERRUPTED_MEMBER" == "$HELD_MEMBER" ]]; then
    printf 'INTERRUPTED_MEMBER and HELD_MEMBER must differ\n' >&2
    return 1
  fi
  if ! [[ "$STATUS_RETRIES" =~ ^[1-9][0-9]*$ && "$STATUS_SLEEP_SECONDS" =~ ^[1-9][0-9]*$ ]]; then
    printf 'STATUS_RETRIES and STATUS_SLEEP_SECONDS must be positive integers\n' >&2
    return 1
  fi
  if ! [[ "$INTERRUPT_CHECKPOINT_RETRIES" =~ ^[1-9][0-9]*$ ]]; then
    printf 'INTERRUPT_CHECKPOINT_RETRIES must be a positive integer\n' >&2
    return 1
  fi
  if [[ "$DKG_CAPTURE_METRICS" != "0" && "$DKG_CAPTURE_METRICS" != "1" ]]; then
    printf 'DKG_CAPTURE_METRICS must be 0 or 1\n' >&2
    return 1
  fi
  if ! [[ "$DKG_METRICS_INTERVAL_SECONDS" =~ ^[1-9][0-9]*$ ]]; then
    printf 'DKG_METRICS_INTERVAL_SECONDS must be a positive integer\n' >&2
    return 1
  fi
  if ! [[ "$DKG_EXPORT_JOBS" =~ ^[1-9][0-9]*$ ]]; then
    printf 'DKG_EXPORT_JOBS must be a positive integer\n' >&2
    return 1
  fi
  if ! [[ "$DKG_START_JOBS" =~ ^[1-9][0-9]*$ ]]; then
    printf 'DKG_START_JOBS must be a positive integer\n' >&2
    return 1
  fi
  if ! [[ "$RUNTIME_START_JOBS" =~ ^[1-9][0-9]*$ ]]; then
    printf 'RUNTIME_START_JOBS must be a positive integer\n' >&2
    return 1
  fi
  if [[ "$FROST_BDK_REGTEST" != "0" && "$FROST_BDK_REGTEST" != "1" ]]; then
    printf 'FROST_BDK_REGTEST must be 0 or 1\n' >&2
    return 1
  fi
  if [[ "$FROST_BDK_REGTEST" == "1" ]]; then
    if ! [[ "$FROST_BDK_MEMBER_REQUEST_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ \
      && "$FROST_BDK_MEMBER_REQUEST_MAX_RETRIES" =~ ^[0-9]+$ ]]; then
      printf 'FROST BDK member request timeout/retry values are invalid\n' >&2
      return 1
    fi
    command -v jq >/dev/null 2>&1 || { printf 'jq is required for FROST BDK regtest\n' >&2; return 1; }
    command -v "$CDK_CLI_BIN" >/dev/null 2>&1 || { printf 'cdk-cli is required for FROST BDK regtest\n' >&2; return 1; }
    if [[ -n "$BITCOIN_DOCKER_CONTAINER" ]]; then
      command -v docker >/dev/null 2>&1 || { printf 'docker is required for containerized Bitcoin Core\n' >&2; return 1; }
    else
      command -v "$BITCOIN_CLI_BIN" >/dev/null 2>&1 || { printf 'bitcoin-cli is required for FROST BDK regtest\n' >&2; return 1; }
    fi
  fi
}

handle_signal() {
  trap - INT TERM
  exit 130
}

trap cleanup EXIT
trap handle_signal INT TERM
validate_live_dkg_smoke
reset_live_dkg_state
DKG_SETUP_STARTED_SECONDS=$SECONDS

start_metrics_monitor
start_dkg_members_bounded

interrupted_before="$(wait_for_interrupt_checkpoint "$INTERRUPTED_MEMBER")"
interrupted_ceremony_before="$(status_field "$interrupted_before" participant_state_ceremonies)"
stop_member "$INTERRUPTED_MEMBER"
wait_for_dkg_participant "$HELD_MEMBER" >/dev/null
sleep "$STATUS_SLEEP_SECONDS"
if member_dkg_records_complete "$HELD_MEMBER"; then
  printf 'live DKG completed while a required participant was offline\n' >&2
  exit 1
fi

start_member "$INTERRUPTED_MEMBER"
for member in "${MEMBERS[@]}"; do
  wait_for_dkg_ready "$member"
done
for member in "${MEMBERS[@]}"; do
  wait_for_dkg_driver_metric_completion "$member"
done
sample_dkg_metrics
stop_metrics_monitor
for member in "${MEMBERS[@]}"; do
  stop_member "$member"
done
report_dkg_metrics
DKG_CAPTURE_METRICS=0
interrupted_after="$(member_dkg_setup_line "$INTERRUPTED_MEMBER")"
interrupted_ceremony_after="$(status_field "$interrupted_after" participant_state_ceremonies)"
if [[ "$interrupted_ceremony_before" != "$interrupted_ceremony_after" || "$(status_field "$interrupted_after" participant_states)" != "1" ]]; then
  printf 'interrupted member did not resume exactly one durable DKG ceremony\n' >&2
  exit 1
fi

export_final_configs
compare_final_public_configs

DKG_SETUP_PHASE=0
start_runtime_members_bounded
for member in "${MEMBERS[@]}"; do
  wait_for_member_status "$member"
done
wait_for_converged

if [[ "$FROST_BDK_REGTEST" == "1" ]]; then
  run_frost_bdk_regtest
else
  "$CDK_MINTD_BIN" federation smoke-operations \
    --public-config "$FINAL_PUBLIC_CONFIG" \
    --private-config "$(member_final_private_config "$PRIMARY_MEMBER")" \
    --unit "$UNIT" \
    --mint-amount 16 \
    --scenario standard \
    --quote-retries "$SMOKE_QUOTE_RETRIES" \
    --quote-sleep-ms "$SMOKE_QUOTE_SLEEP_MS" \
    --operation-timeout-seconds "$SMOKE_OPERATION_TIMEOUT_SECONDS"
  wait_for_converged
  printf 'live dealer-free DKG mint/swap/melt/restore smoke passed\n'
fi
