# Generated by cdk-mintd federation test-trusted-dealer.
# Contains local test secrets. Do not commit this file.
# Start this member with:
# cdk-mintd --work-dir @@WORK_DIR@@ config init --new-mint --file @@CONFIG_PATH@@
# Then start cdk-mintd using the same work directory.

[info]
url = @@MINT_URL@@
listen_host = @@LISTEN_HOST@@
listen_port = @@LISTEN_PORT@@
mnemonic = @@MNEMONIC@@
enable_info_page = true

[info.http_cache]
backend = "memory"
ttl = 60
tti = 60

[mint_info]
name = @@NAME@@
description = @@DESCRIPTION@@

# @@PROMETHEUS_CONFIG@@

# @@DATABASE_CONFIG@@
[[payment_backend]]
backend = "fakewallet"
unit = @@LN_UNIT@@
min_mint = 1
max_mint = 500000
min_melt = 1
max_melt = 500000

[fake_wallet]
supported_units = [@@SUPPORTED_UNIT@@]
fee_percent = 0.0
reserve_fee_min = 1
min_delay_time = 0
max_delay_time = 0

[federation]
enabled = true
allow_development_payment_observation_policy = true
public_config_path = @@PUBLIC_CONFIG_PATH@@
private_config_path = @@PRIVATE_CONFIG_PATH@@
