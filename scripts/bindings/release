#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
if [[ $(uname -s) == Darwin && -z ${CDK_RELEASE_XCODE:-} ]]; then
    export CDK_RELEASE_XCODE=${DEVELOPER_DIR:-$(/usr/bin/xcode-select -p)}
fi
exec nix develop --no-update-lock-file "path:$root#bindings-release-tools" \
    --command python3 "$root/scripts/bindings/release.py" --root "$root" "$@"
